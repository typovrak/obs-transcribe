#!/usr/bin/env bash
# Debian / Ubuntu launcher: ./transcribe-debian ~/Videos/my-video.mp4
#
# First run: installs ffmpeg, python3 and the build tools with apt (asks for sudo), then builds
# whisper.cpp from source with Vulkan GPU support into ~/.local/share/obs-transcribe/. Later runs
# start transcribe.py straight away. To rebuild whisper.cpp, delete that whisper.cpp-* directory.
#
# Environment variables:
#   TRANSCRIBE_GPU=vulkan|cuda|cpu  whisper.cpp backend to build [vulkan if glslc and recent Vulkan headers are available, else cpu]
set -euo pipefail

WHISPER_VERSION="1.9.5"
WHISPER_URL="https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v${WHISPER_VERSION}.tar.gz"

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
data="${XDG_DATA_HOME:-$HOME/.local/share}/obs-transcribe"

log() { printf '%s\n' "$*" >&2; }
die() { log "Error: $*"; exit 2; }

[[ -r /etc/debian_version ]] || die "this launcher is for Debian and Ubuntu (apt). On NixOS, use ./transcribe."
command -v apt-get >/dev/null || die "apt-get not found."

sudo_cmd=()
[[ $(id -u) -eq 0 ]] || sudo_cmd=(sudo)

apt_updated=0
apt_update() {
  ((apt_updated)) && return 0
  "${sudo_cmd[@]}" apt-get update -qq
  apt_updated=1
}

# Install the apt packages that are missing, if any.
apt_install() {
  local missing=() pkg
  for pkg in "$@"; do
    [[ "$(dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null)" == "install ok installed" ]] || missing+=("$pkg")
  done
  ((${#missing[@]})) || return 0
  log "Installing with apt: ${missing[*]}"
  apt_update
  "${sudo_cmd[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
}

# No "| grep -q": grep would exit at the first match and pipefail would report apt-cache's SIGPIPE.
apt_candidate() { [[ "$(apt-cache policy "$1" 2>/dev/null)" =~ Candidate:\ [^\(] ]]; }
apt_has() { apt_candidate "$1" || { apt_update && apt_candidate "$1"; }; }

# whisper.cpp's Vulkan backend uses VK_EXT_layer_settings, which needs Vulkan headers >= 1.3.272
# (Debian 12 ships 1.3.239, Ubuntu 24.04 ships 1.3.275).
VULKAN_HEADERS_MIN="1.3.272"
vulkan_headers_ok() {
  local version
  version="$(apt-cache policy libvulkan-dev 2>/dev/null | sed -n 's/^ *Candidate: //p')"
  [[ -n "$version" && "$version" != "(none)" ]] && dpkg --compare-versions "$version" ge "$VULKAN_HEADERS_MIN"
}

# Build whisper-cli for backend $1 into directory $2. Runs in a subshell (see try_build).
build_whisper() {
  local gpu="$1" prefix="$2"
  local cmake_gpu=() build_deps=(build-essential cmake curl ca-certificates)
  case "$gpu" in
    vulkan) build_deps+=(libvulkan-dev glslc spirv-headers); cmake_gpu=(-DGGML_VULKAN=ON) ;;
    cuda)
      export PATH="$PATH:/usr/local/cuda/bin"
      command -v nvcc >/dev/null \
        || die "TRANSCRIBE_GPU=cuda needs the CUDA toolkit (nvcc): apt install nvidia-cuda-toolkit, or NVIDIA's packages."
      cmake_gpu=(-DGGML_CUDA=ON) ;;
    cpu) ;;
    *) die "TRANSCRIBE_GPU must be vulkan, cuda or cpu (got \"$gpu\")." ;;
  esac
  apt_install "${build_deps[@]}"

  local src
  src="$(mktemp -d "${TMPDIR:-/tmp}/whisper.cpp-build.XXXXXX")"
  # shellcheck disable=SC2064  # expand now: $src and $prefix are local
  trap "rm -rf '$src' '$prefix.tmp'" EXIT
  log "Downloading whisper.cpp v${WHISPER_VERSION}"
  curl -fsSL "$WHISPER_URL" | tar -xz -C "$src" --strip-components=1
  log "Building whisper.cpp (backend: $gpu). This takes a few minutes, once."
  # Static build: a single whisper-cli binary, no shared libraries to locate at run time.
  cmake -S "$src" -B "$src/build" -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
    -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_SERVER=OFF -DWHISPER_SDL2=OFF "${cmake_gpu[@]}" >&2
  cmake --build "$src/build" --config Release -j "$(nproc)" --target whisper-cli >&2
  install -Dm755 "$src/build/bin/whisper-cli" "$prefix.tmp/bin/whisper-cli"
  rm -rf "$prefix"
  mv "$prefix.tmp" "$prefix"
  log "whisper.cpp installed in $prefix"
}

# Run build_whisper with errexit really on, and store its exit status in $build_status. Never call
# it from "if", "&&" or "||": bash ignores "set -e" there, down into functions and subshells.
try_build() {
  set +e
  (set -e; build_whisper "$@")
  build_status=$?
  set -e
}

apt_install python3 ffmpeg

# Reuse an existing build if there is one: the requested backend, or any backend by default.
whisper_bin=""
for candidate in "$data"/whisper.cpp-"$WHISPER_VERSION"-${TRANSCRIBE_GPU:-*}/bin/whisper-cli; do
  [[ -x "$candidate" ]] && { whisper_bin="$candidate"; break; }
done
if [[ -z "$whisper_bin" ]]; then
  gpu="${TRANSCRIBE_GPU:-}"
  if [[ -z "$gpu" ]]; then
    if apt_has glslc && apt_has spirv-headers && vulkan_headers_ok; then
      gpu=vulkan
    else
      gpu=cpu
      log "Note: this release lacks glslc or has Vulkan headers older than $VULKAN_HEADERS_MIN"
      log "      (Debian 12, Ubuntu 22.04...), so whisper.cpp is built for the CPU only."
      log "      TRANSCRIBE_GPU=cuda builds it for an NVIDIA GPU if the CUDA toolkit is installed."
    fi
  fi
  try_build "$gpu" "$data/whisper.cpp-$WHISPER_VERSION-$gpu"
  if ((build_status)); then
    # Only fall back by ourselves: an explicit TRANSCRIBE_GPU is an order, not a hint.
    [[ $gpu != cpu && -z "${TRANSCRIBE_GPU:-}" ]] || die "the whisper.cpp build failed (see above)."
    log "The $gpu build of whisper.cpp failed (see above); building it for the CPU instead."
    gpu=cpu
    try_build "$gpu" "$data/whisper.cpp-$WHISPER_VERSION-$gpu"
    ((build_status == 0)) || die "the whisper.cpp build failed (see above)."
  fi
  whisper_bin="$data/whisper.cpp-$WHISPER_VERSION-$gpu/bin/whisper-cli"
fi

PATH="$(dirname "$whisper_bin"):$PATH"
export PATH
exec python3 "$dir/transcribe.py" "$@"
